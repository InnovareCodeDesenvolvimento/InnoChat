// ---------------------------------------------------------------------------
// Fase 7 — Cadastro público, planos e cobrança (§7, §15)
// ---------------------------------------------------------------------------

// Catálogo de planos, editado pelo admin da plataforma (tela "Planos", §9). Global, não
// tenant-scoped.
//
// Preço (decisão do dono, 2026-09-28): ainda não definido. Em vez de gravar um valor "provisório"
// que alguém pode esquecer de trocar antes do lançamento, o seed cria os 3 planos com
// `priceCents = 0` e `active = false` — mais seguro que um preço chutado: com `active = false`
// eles não aparecem no cadastro público nem podem ser escolhidos, então é estruturalmente
// impossível vender por engano a um preço errado. O admin edita o preço e ativa quando o dono
// decidir (tela "Planos", §9). Ver PENDÊNCIAS no handoff.
model Plan {
  id   String @id @default(cuid())
  code String @unique
  name String

  priceCents           Int
  // Preço do plano ANUAL, cobrado de uma vez a cada 12 meses (centavos). NULO = o plano não tem
  // opção anual. Preço explícito (e não % de desconto): o dono decide o número que o cliente vê, sem
  // arredondamento escondido; o desconto exibido ("2 meses grátis") é derivado de priceCents*12.
  // CHECK: > 0. MRR do anual = annualPriceCents / 12.
  annualPriceCents     Int?
  // Preços dos ciclos TRIMESTRAL (3 meses) e SEMESTRAL (6 meses), cobrados de uma vez, em centavos.
  // NULO = ciclo não oferecido pelo plano (mensal = priceCents; anual = annualPriceCents). CHECK: > 0.
  quarterlyPriceCents  Int?
  semiannualPriceCents Int?

  maxWhatsappNumbers Int
  // null = ilimitado (plano Clínica, §7.2). maxWhatsappNumbers nunca é ilimitado nos 3 planos
  // aprovados, por isso não é nullable — só maxProfessionals precisa do null.
  maxProfessionals   Int?

  active    Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")
  couponPlans          CouponPlan[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

// Uma assinatura por tenant (§5: "Subscription (1 por tenant)") — `tenantId` é @unique, não só
// indexado, e é isso que a constraint de banco reforça: nunca existem duas linhas de Subscription
// para o mesmo tenant, nem uma "segunda assinatura ativa" nem histórico de assinaturas antigas.
// Trocar de plano reescreve esta mesma linha (`planId`/`pendingPlanId`); cancelar e reativar
// também (`status` volta a ACTIVE, §7.4). Se algum dia precisar de histórico de assinaturas
// (ex.: auditoria de troca de plano), isso é tabela nova, não a remoção deste unique.
//
// Overrides de limite (`maxWhatsappNumbersOverride`/`maxProfessionalsOverride`) já existem em
// `Tenant` desde a Fase 1 (§5) — decisão: não duplicar aqui. Um valor só, sem duas fontes que
// podem divergir sobre "qual limite vale". Ver PARA O PRÓXIMO no handoff.
model Subscription {
  id       String @id @default(cuid())
  tenantId String @unique

  planId        String
  pendingPlanId String?
  status        SubscriptionStatus @default(TRIALING)

  // Trial de 1 dia (decisão do dono, 2026-09-28): preenchido no cadastro como `createdAt + 24h`.
  // Nulo depois que a assinatura sai de TRIALING (não volta a preencher em downgrade/reativação).
  trialEndsAt      DateTime?
  // Fim do período pago corrente. No cadastro, já nasce igual a `trialEndsAt` (o trial É o
  // primeiro período, e a primeira fatura — §7.3 — cobre esse mesmo ciclo). Avança em +1 mês a
  // cada pagamento confirmado (§7.1), mantendo o dia-âncora.
  currentPeriodEnd DateTime

  canceledAt DateTime?

  // Cancelamento pelo painel (decisão do dono, 2026-10-01). `cancelAtPeriodEnd` = o OWNER agendou
  // o cancelamento: tudo segue funcionando até o fim do período corrente (`currentPeriodEnd`, ou
  // `trialEndsAt` em teste), sem nova fatura; nessa data a assinatura vira CANCELED. `cancelRequestedAt`
  // e `cancelReason` (texto livre opcional, máx. 500) ficam gravados para o dono da plataforma
  // aprender; `canceledAt` só é preenchido quando o cancelamento de fato vale.
  cancelAtPeriodEnd Boolean   @default(false)
  cancelRequestedAt DateTime?
  cancelReason      String?

  // Marca de e-mail já enviado (Vega, Fase 7 — billing/tick): sem isto, rodar o tick de hora em
  // hora reenviaria o aviso de "atendimento suspenso" a cada rodada enquanto o tenant continuar
  // SUSPENDED. Nulo = ainda não avisado NESTA suspensão; volta a nulo quando a assinatura sai de
  // SUSPENDED (reativação/pagamento), para avisar de novo numa suspensão futura.
  suspendedEmailSentAt DateTime?

  // Primeiro pagamento confirmado (decisão do dono, 2026-09-29). Nulo = nunca pagou: é o que
  // separa "teste não convertido" (cancela 7 dias depois da suspensão) de ex-pagante (60 dias).
  // Gravado uma vez, em `applyInvoicePayment`; nunca volta a nulo.
  firstPaidAt DateTime?

  // Suspensão feita À MÃO pelo admin (fraude, pedido do dono): não é atraso, então a régua não cobra e o
  // status efetivo continua SUSPENDED mesmo que a data de vencimento "artificial" caísse na carência.
  // Gravada em `suspendCompanyManually`; volta a nulo no pagamento e na reativação manual.
  manualSuspendedAt DateTime?

  // Ciclo de cobrança: MONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL (CHECK). Default MONTHLY. O período
  // avança 1/3/6/12 meses e a fatura usa priceCents / quarterlyPriceCents / semiannualPriceCents /
  // annualPriceCents do plano.
  billingCycle          String  @default("MONTHLY")
  // Cupom em vigor. Sem cupom: os dois nulos. `couponCyclesRemaining` NULO com cupom = FOREVER; número
  // = faturas ainda descontadas (decrementa a cada fatura gerada com desconto; ao chegar a 0 o código
  // zera `couponId`). A unidade é FATURA (não mês): num plano trimestral, "3 ciclos" = 3 faturas = 9
  // meses. Cupom nunca é apagado (ON DELETE RESTRICT): desative-o.
  couponId              String?
  couponCyclesRemaining Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan           Plan            @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan    Plan?           @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  invoices       Invoice[]
  billingNotices BillingNotice[]
  billingEvents  BillingEvent[]

  // billing/tick (§6.8) roda a cada hora e precisa achar, sem varrer a tabela inteira:
  // - quem está perto de vencer (gerar fatura 5 dias antes / expirar trial) → (status, currentPeriodEnd)
  // - quem ainda está no trial de 1 dia, para fechar TRIALING → PAST_DUE → (status, trialEndsAt)
  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([couponId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  OPEN
  PAID
  EXPIRED
  VOID
}

// Pendurada em Subscription, não em Tenant direto (§5, diagrama) — segue o padrão já usado em
// AppointmentEvent/ChatSession/InboundEvent (models tenant-scoped SEM coluna tenantId própria,
// isolados por relação até o pai que tem `tenantId`). Ver PARA O PRÓXIMO no handoff: Invoice NÃO
// entra em TENANT_SCOPED_MODELS por não ter `tenantId` próprio — quem ler Invoice precisa
// carregar a Subscription (já escopada por tenant) primeiro.
model Invoice {
  id             String @id @default(cuid())
  subscriptionId String

  amountCents Int
  periodStart DateTime
  periodEnd   DateTime
  dueAt       DateTime

  status InvoiceStatus @default(OPEN)

  // Pix (Mercado Pago, §7.1). `pixExpiresAt` = geração + 3 dias; se expirar, o `billing/tick`
  // marca EXPIRED (não paga) e o Pix é regerado sob demanda pela tela de Assinatura, na MESMA
  // fatura (não cria outra linha — só reescreve mpPaymentId/pixQrCode/pixCopyPaste/pixExpiresAt).
  mpPaymentId  String?
  pixQrCode    String?
  pixCopyPaste String?
  pixExpiresAt DateTime?
  paidAt       DateTime?

  // Ambiente do Mercado Pago (PRODUCTION/SANDBOX) em que o Pix foi gerado: a conciliação consulta
  // o pagamento com as credenciais DESSE ambiente, mesmo que o admin troque o ativo depois. Nulo =
  // legado (tenta o ativo). `mpLastCheckedAt` = última consulta ativa ao MP (rate limit no banco).
  mpEnvironment   MercadoPagoEnvironment?
  mpLastCheckedAt DateTime?

  // Marcas de e-mail já enviado (Vega, Fase 7 — billing/tick, §7.1 "aviso... 1 dia antes do
  // vencimento e no vencimento"): sem isto, um tick de hora em hora reenviaria o mesmo lembrete
  // várias vezes no mesmo dia. Nulo = ainda não enviado; nunca voltam a nulo (é por fatura, e
  // cada fatura só tem 1 vencimento).
  dueReminderEmailSentAt DateTime?
  dueTodayEmailSentAt    DateTime?

  // Fatura criada no cadastro, que cobre o trial (`signup/service.ts`). Enquanto OPEN, não é
  // "a receber" nem "vencida" no Admin → Cobrança: é o card "Em teste". Se o cliente não assina,
  // o `billing/tick` a anula (VOID) no cancelamento da conta.
  isTrialConversion Boolean @default(false)

  // Instante em que o Mercado Pago confirmou um pagamento para esta fatura JÁ ANULADA (VOID): o
  // dinheiro entrou mas a fatura não foi baixada. Alimenta o aviso PAYMENT_ON_VOID_INVOICE no sino
  // do admin (que decide o estorno). Nulo na imensa maioria das faturas.
  paidWhileVoidAt DateTime?

  // Qual pagamento do MP baixou esta fatura ("manual" = baixa manual do admin). Serve para reconhecer um SEGUNDO
  // pagamento (Pix antigo/regerado pago depois que a fatura já estava PAID): `duplicatePaymentAt` marca o
  // instante e acende o aviso no sino do admin, que decide o estorno (manual, decisão do dono).
  paidByPaymentId    String?
  duplicatePaymentAt DateTime?

  // Cupom e ciclo (Onda 0, item 6). `amountCents` continua sendo o valor LÍQUIDO a cobrar (o que o Pix
  // e todo código existente já usam); `discountCents` é o desconto já abatido, então bruto =
  // amountCents + discountCents. `couponCode` = snapshot do código (o cupom pode mudar/desativar depois).
  // `cycle` = MONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL do período desta fatura. CHECKs: discountCents >= 0 e cycle fechado.
  discountCents Int     @default(0)
  couponCode    String?
  cycle         String  @default("MONTHLY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription      Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingNotices    BillingNotice[]
  billingEvents     BillingEvent[]
  couponRedemptions CouponRedemption[]

  // Uma fatura por ciclo de cobrança (§5): impede o billing/tick gerar duas faturas para o mesmo
  // período se rodar em cima da hora (idempotência "por desenho", não só pelo `{ invoicesCreated }`
  // da resposta).
  @@unique([subscriptionId, periodStart])
  // billing/tick: faturas OPEN vencendo (lembrete + baixa de PAST_DUE) e Pix OPEN a expirar.
  @@index([status, dueAt])
  @@index([status, pixExpiresAt])
  // Webhook do Mercado Pago (§6.10): acha a fatura pelo id do pagamento antes de reconsultar a API.
  @@index([mpPaymentId])
  @@index([paidWhileVoidAt])
  @@index([duplicatePaymentAt])
  @@map("invoices")
}

// Idempotência do webhook do Mercado Pago (§6.10, §11): `provider` + `providerEventId` são a
// dedupe de verdade — o mesmo evento reentregue (retry do MP) não reprocessa. `payload` guarda o
// corpo bruto para auditoria; `processedAt` nulo = recebido mas ainda não aplicado (o handler
// sempre reconsulta `GET /v1/payments/{id}` antes de dar baixa, nunca confia neste payload).
// Global (não tenant-scoped): o evento chega sem tenant resolvido até o handler achar a fatura
// pelo `mpPaymentId`.
model ProviderEvent {
  id              String @id @default(cuid())
  provider        String
  providerEventId String

  payload     Json
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("provider_events")
}

// Anti-abuso de trial em série (§7.3 regra 4): um número de WhatsApp só entra em trial uma vez,
// em qualquer empresa. Por isso `phoneE164` é @unique sozinho (não composto com tenantId) — a
// verificação precisa ser CROSS-tenant por desenho, o oposto de todo o resto do isolamento por
// tenant do sistema. `tenantId` aqui é só "qual empresa consumiu o trial deste número", para a
// mensagem de erro/auditoria — nunca use este campo para escopo de leitura.
// NÃO entra em TENANT_SCOPED_MODELS mesmo tendo `tenantId` próprio (ver PARA O PRÓXIMO no
// handoff): `forTenant()` filtraria por tenant e quebraria exatamente a checagem cross-tenant que
// este model existe para fazer.
model TrialClaim {
  id          String  @id @default(cuid())
  phoneE164   String  @unique
  emailDomain String?
  tenantId    String

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("trial_claims")
}

// ---------------------------------------------------------------------------
// Régua de cobrança (docs/regua-de-cobranca.md, F1) — outbox, histórico e WhatsApp da plataforma
// ---------------------------------------------------------------------------

// Outbox da régua: UMA linha por (ciclo, etapa, canal), garantida pelo unique. `step`/`channel`/`status`
// são String (não enum do Postgres) porque a régua ganha etapas e `ALTER TYPE ADD VALUE` não roda na
// transação da migration; `channel` e `status` têm CHECK no banco (conjuntos fechados), `step` não.
//
// `cycleKey` identifica o CICLO a que o aviso pertence e é o que impede duplicata:
//   - etapas de fatura (INVOICE_CREATED, DUE_*, OVERDUE_*, GRACE_LAST, PAYMENT_CONFIRMED): `invoiceId`;
//   - etapas de teste (TRIAL_*): `<subscriptionId>:trial` (a assinatura é 1:1 e o teste só existe uma vez);
//   - etapas de suspensão e cancelamento (SUSPENDED*, CANCEL_WARN_*, AUTO_CANCELED):
//     `<subscriptionId>:<currentPeriodEnd em ISO UTC, ex. 2026-10-01T23:59:00.000Z>`, o período NÃO pago
//     (fixo durante toda a suspensão; muda quando o cliente paga). Preferido ao "início da suspensão" do
//     plano porque este depende da carência (1 dia hoje, 3 na F2) e mudaria a chave no dia do deploy.
//
// Despachante: `UPDATE ... SET status='SENDING' WHERE id IN (SELECT ... WHERE status IN ('PENDING','FAILED')
// AND "nextAttemptAt" <= now() ORDER BY "nextAttemptAt" FOR UPDATE SKIP LOCKED LIMIT n)`. O índice
// (status, nextAttemptAt) serve a esse claim e à varredura de SENDING preso (`updatedAt` antigo).
// Privacidade: `lastErrorCode` só guarda código; `recipientMasked` é o destinatário mascarado.
//
// Não está em TENANT_SCOPED_MODELS (como TrialClaim): o despachante lê cross-tenant por desenho.
model BillingNotice {
  id             String  @id @default(cuid())
  tenantId       String
  subscriptionId String
  // Nulo nas etapas de teste e de suspensão/cancelamento (sem fatura própria).
  invoiceId      String?

  step     String
  channel  String // EMAIL | WHATSAPP (CHECK)
  cycleKey String
  status   String @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED (CHECK)

  // PAID | STATUS_CHANGED | NO_RECIPIENT | OPTED_OUT | NO_PLATFORM_NUMBER | CHANNEL_DOWN |
  // OUT_OF_WINDOW_EXPIRED | PERMANENT_REJECTION | LEGACY_SENT. Preenchido só com status SKIPPED (CHECK).
  skippedReason String?

  attempts      Int       @default(0)
  // Início da janela de envio / depois disso o aviso não faz mais sentido / próxima tentativa.
  notBefore     DateTime
  expiresAt     DateTime
  nextAttemptAt DateTime
  lastErrorCode String?
  sentAt        DateTime?

  recipientMasked   String?
  providerMessageId String?
  // Resposta curta do servidor SMTP no envio de e-mail (sem endereços, até 200 caracteres). Evidência de que o servidor aceitou.
  providerResponse  String?

  // F6 (registro global do Admin). `recipient` = destino COMPLETO (dado pessoal, só no banco, nunca em log; a manutenção zera
  // após 12 meses junto com `renderedText`). `recipientKind`: OWNER | BILLING_EMAIL | BILLING_WHATSAPP (CHECK).
  // `renderedSubject`/`renderedText` = snapshot do que foi enviado (ou tentado). Avisos anteriores à F6 ficam nulos.
  recipient       String?
  recipientKind   String?
  renderedSubject String?
  renderedText    String?

  // WhatsApp: qual conexão da plataforma enviou e cópia do número no instante do envio (trocar de número
  // não apaga o histórico). A conexão nunca é apagada depois de usada; `SetNull` só cobre o descarte de
  // uma conexão PENDING.
  platformConnectionId String?
  senderPhoneE164      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription       Subscription                @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice            Invoice?                    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  platformConnection PlatformWhatsappConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: SetNull)

  @@unique([cycleKey, step, channel])
  // Claim do despachante e varredura de SENDING preso.
  @@index([status, nextAttemptAt])
  // Linha do tempo da empresa (Admin).
  @@index([tenantId, createdAt])
  // Registro global do Admin: ordem por última mudança + id (cursor).
  @@index([updatedAt, id])
  @@map("billing_notices")
}

// Histórico append-only de mudanças de status e eventos financeiros por empresa (churn e linha do tempo).
// Nunca atualizado (trigger bloqueia UPDATE; a limpeza por cascata de tenant continua valendo).
// `type` é String (cresce): STATUS_CHANGED | INVOICE_CREATED | PAYMENT_CONFIRMED | PIX_REGENERATED |
// PLAN_CHANGED | CANCEL_REQUESTED | CANCEL_UNDONE | REACTIVATION_STARTED | MANUAL_PAYMENT |
// MANUAL_SUSPEND | MANUAL_REACTIVATE | TRIAL_EXTENDED. `actorType`: SYSTEM | OWNER | ADMIN (CHECK).
// `metadata` nunca leva dado pessoal. Cancelamento voluntário x involuntário (`cancelSource`) vai em
// `metadata.cancelSource`: OWNER | AUTO_SUSPENDED | TRIAL_NOT_CONVERTED | ADMIN.
// Linhas da carga inicial (F6) levam `metadata.backfill = true`.
// Não está em TENANT_SCOPED_MODELS: lido cross-tenant pelo Admin (churn).
model BillingEvent {
  id             String  @id @default(cuid())
  tenantId       String
  subscriptionId String
  invoiceId      String?

  type       String
  fromStatus SubscriptionStatus?
  toStatus   SubscriptionStatus?

  actorType   String  @default("SYSTEM")
  // Sem FK de propósito: auditoria sobrevive à exclusão do usuário (mesmo critério de n8nBotFlowPublishedByUserId).
  actorUserId String?
  metadata    Json?

  createdAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // Linha do tempo da empresa.
  @@index([tenantId, createdAt])
  // Churn e recuperação no mês: filtra por tipo (e por toStatus) dentro de um intervalo de datas.
  @@index([type, createdAt])
  @@map("billing_events")
}

// Números de WhatsApp da PLATAFORMA para avisos de cobrança (docs/regua-de-cobranca.md §2.4). Cada número
// conectado é uma linha; as antigas viram histórico (RETIRED), nunca são apagadas depois de usadas.
// Por que não `WhatsappInstance`: `tenantId` é obrigatório lá e o `syncN8n` reaponta o webhook de toda
// instância para o bot do n8n.
//
// Papéis (`role`): PENDING = QR aberto, ainda não assumiu; ACTIVE = é quem envia; RETIRED = saiu.
// Dois índices ÚNICOS PARCIAIS (SQL escrito à mão na migration, o Prisma não os expressa) garantem no
// banco no máximo 1 ACTIVE e no máximo 1 PENDING. CHECKs: role/status em conjuntos fechados; ACTIVE exige
// `phoneE164` e `activatedAt`; RETIRED exige `retiredAt`.
// Só o HASH do token do webhook fica em repouso. Não está em TENANT_SCOPED_MODELS (é da plataforma).
model PlatformWhatsappConnection {
  id               String  @id @default(cuid())
  // Nome da instância na Evolution, único por conexão: "innochat-plataforma-<8 chars do id>".
  instanceName     String  @unique
  webhookTokenHash String  @unique
  // Rótulo livre do admin ("Cobrança", "Cobrança (chip novo)"); limite de 40 na validação.
  label            String
  status           String  @default("QRCODE") // QRCODE | CONNECTED | DISCONNECTED (CHECK)
  role             String  @default("PENDING") // PENDING | ACTIVE | RETIRED (CHECK)
  // Propósito da conexão: BILLING (régua de cobrança) ou RESCUE (resgate de leads).
  purpose          String  @default("BILLING")
  // Só dígitos com DDI, preenchido ao conectar (ownerJid).
  phoneE164        String?

  connectedAt     DateTime?
  // Queda inesperada; zera ao reconectar.
  disconnectedAt  DateTime?
  activatedAt     DateTime?
  retiredAt       DateTime?
  // REPLACED | DISCONNECTED_BY_ADMIN | ABANDONED_QR. Sem FK em `createdByUserId` (auditoria simples).
  retiredReason   String?
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notices     BillingNotice[]
  rescueLeads RescueLead[]

  @@index([role])
  @@index([purpose, role])
  // Trava anti-loop do claim: "este remetente é número da plataforma (de qualquer papel)?".
  @@index([phoneE164])
  @@map("platform_whatsapp_connections")
}

// ---------------------------------------------------------------------------
// Fase 2 — Histórico de conversas e notificações da plataforma
// ---------------------------------------------------------------------------

enum ChatDirection {
  INBOUND
  OUTBOUND
}

model ChatMessage {
  id                 String        @id @default(cuid())
  tenantId           String
  contactId          String
  whatsappInstanceId String?
  direction          ChatDirection
  body               String
  // Id da mensagem no provedor (Evolution) — dedup de webhook repetido. Nulo permite vários.
  providerMessageId  String?
  // Atendente que enviou pelo painel (null = bot ou cliente). SetNull preserva o histórico se o usuário for apagado.
  authorUserId       String?
  createdAt          DateTime      @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  authorUser       User?             @relation("ChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId, contactId, createdAt])
  // Purga por data (retenção de 90 dias) e cascade/deleteMany por contato.
  @@index([createdAt])
  @@index([contactId])
  @@map("chat_messages")
}

model PlatformNotificationRead {
  id              String   @id @default(cuid())
  userId          String
  notificationKey String
  readAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@map("platform_notification_reads")
}

// ---------------------------------------------------------------------------
// Melhorias de outubro/2026 (docs/plano-melhorias-2026-10.md) — schema da Onda 0.
// Conjuntos fechados (status, papel, origem...) são String + CHECK, como BillingNotice/BillingEvent:
// somar um valor é uma migration de CHECK, sem ALTER TYPE. Nada aqui entra em env var.
// ---------------------------------------------------------------------------

// Item 1 — Monitor de erros próprio. Um grupo = uma "assinatura" (fingerprint) de erro; cada
// ocorrência é um ErrorEvent. Global (plataforma): fora de TENANT_SCOPED_MODELS; lido só pelo Admin.
// `fingerprint` = sha256 hex de (origem + tipo + mensagem normalizada + 1º frame útil), calculado no
// código. O upsert é `INSERT ... ON CONFLICT (fingerprint) DO UPDATE SET count = count + 1,
// lastSeenAt = now(), ...`. Reocorrência de grupo RESOLVED reabre (status OPEN, resolvedAt nulo).
// `source`: SERVER | CLIENT. `status`: OPEN | RESOLVED | IGNORED. `message` até 300 e `type` até 120
// (CHECK). `alertedAt` = quando saiu o aviso de "erro novo" (sino + e-mail): evita reenviar.
// Nunca guardar PII: só ids, rota sem query string e stack truncada.
model ErrorGroup {
  id               String    @id @default(cuid())
  fingerprint      String    @unique
  message          String
  type             String
  source           String
  // Rota da ÚLTIMA ocorrência (atualizada junto com lastSeenAt).
  route            String?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  count            Int       @default(1)
  status           String    @default("OPEN")
  firstVersion     String?
  lastVersion      String?
  alertedAt        DateTime?
  resolvedAt       DateTime?
  // Sem FK: a auditoria sobrevive à exclusão do usuário.
  resolvedByUserId String?

  events ErrorEvent[]

  // Tela Admin → Erros: lista por última ocorrência, filtrada por status.
  @@index([lastSeenAt])
  @@index([status, lastSeenAt])
  @@map("error_groups")
}

// Ocorrência. RETENÇÃO: a manutenção apaga eventos com mais de 30 dias (índice em occurredAt) e o
// código limita ocorrências guardadas por grupo; o ErrorGroup (contador) permanece. `userId`/`tenantId`
// são só ids (sem FK, sem PII: sobrevivem à exclusão e não travam o purge). `stack` até 8000 bytes e
// `context` até 4096 bytes (CHECKs).
model ErrorEvent {
  id         String   @id @default(cuid())
  groupId    String
  occurredAt DateTime @default(now())
  version    String?
  route      String?
  stack      String?
  userId     String?
  tenantId   String?
  context    Json?

  group ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, occurredAt])
  @@index([occurredAt])
  @@map("error_events")
}

// Item 2 — Backup (espelha o Parque das Feiras). Singleton `id = 1` (CHECK id = 1; o código faz upsert,
// e a migration já cria a linha, desligada). Destino é ESCOLHA explícita (`destination`), nunca deduzido
// de campos preenchidos; nulo = o agendamento não liga. `destination`: S3 | DRIVE. `driveMode`:
// SERVICE_ACCOUNT | OAUTH. `hourLocal` 0-23 em hora de Brasília (UTC-3 fixo). Segredos (`*Enc`)
// cifrados com src/lib/crypto.ts e nunca devolvidos à tela. `runningSince` = trava de execução única
// (UPDATE condicional). `lastSuccessAt`/`lastAttemptAt` desnormalizados para a tela e o alerta.
// `lastLateAlertAt` limita o e-mail "backup atrasado".
model BackupConfig {
  id Int @id @default(1)

  enabled         Boolean @default(false)
  hourLocal       Int     @default(3)
  retentionDays   Int     @default(14)
  alertAfterHours Int     @default(36)
  destination     String?
  driveMode       String  @default("SERVICE_ACCOUNT")

  s3Endpoint     String?
  s3Bucket       String?
  s3Region       String?
  s3Prefix       String?
  s3AccessKey    String?
  s3SecretKeyEnc String?

  driveFolderId          String?
  driveClientEmail       String?
  driveServiceAccountEnc String?

  driveOauthClientId        String?
  driveOauthClientSecretEnc String?
  driveOauthRefreshTokenEnc String?
  driveOauthEmail           String?
  driveOauthFolderId        String?
  driveOauthConnectedAt     DateTime?
  driveOauthConnectedById   String?

  // Chave PRÓPRIA do backup (32 bytes, independente do AUTH_SECRET), cifrada com src/lib/crypto.ts. A tela só vê a
  // impressão digital (8 hex do sha256). `encryptionKeyShownAt` = quando foi mostrada inteira ao dono (uma única vez).
  encryptionKeyEnc         String?
  encryptionKeyFingerprint String?
  encryptionKeyCreatedAt   DateTime?
  encryptionKeyShownAt     DateTime?

  runningSince    DateTime?
  lastSuccessAt   DateTime?
  lastAttemptAt   DateTime?
  lastLateAlertAt DateTime?

  updatedAt   DateTime @updatedAt
  // Sem FK (config sobrevive ao usuário).
  updatedById String?

  @@map("backup_config")
}

// Histórico de execuções. `status`: RUNNING | SUCCESS | FAILED. `trigger`: SCHEDULED | MANUAL | VERIFY (conferência da cópia mais recente, não é backup).
// `destination` = snapshot do destino usado (S3 | DRIVE; nulo = dump conferido mas sem destino: vale
// como teste, não como backup). `errorCode` = causa classificada (CREDENTIAL, FOLDER, QUOTA, NETWORK,
// DUMP...); `errorDetail` truncado, nunca com DATABASE_URL. `objectKey` = objeto (S3) ou id/nome do
// arquivo (Drive). BigInt em `sizeBytes`.
model BackupRun {
  id                       String    @id @default(cuid())
  status                   String    @default("RUNNING")
  trigger                  String    @default("SCHEDULED")
  destination              String?
  startedAt                DateTime  @default(now())
  finishedAt               DateTime?
  sizeBytes                BigInt?
  tablesWithData           Int?
  objectKey                String?
  errorCode                String?
  errorDetail              String?
  createdById              String?
  // Impressão digital da chave com que a cópia foi cifrada (nulo = não cifrada: antigas e teste sem destino).
  encryptionKeyFingerprint String?

  // Tela lista por data decrescente.
  @@index([startedAt])
  @@map("backup_runs")
}

// Lock de concorrência e estado da operação de Restore pelo Admin (singleton, id = 1).
// Garante execução única (acquire/release atômicos) e guarda o caminho do safety pre-dump.
enum RestoreLockStatus {
  IDLE
  RESTORING
}

model RestoreLock {
  id             Int               @id @default(1)
  status         RestoreLockStatus @default(IDLE)
  lockedBy       String?
  lockedAt       DateTime?
  safetyDumpPath String?
  updatedAt      DateTime          @updatedAt

  @@map("restore_locks")
}

// `state` de uso único do OAuth do Drive (o callback chega pelo navegador, sem sessão de API).
model BackupDriveOauthNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("backup_drive_oauth_nonces")
}

// Item 3 — Códigos de recuperação do 2FA: uma linha por código, só o HASH (sha256) em repouso.
// Tabela (e não JSON no User) para consumir um código de forma atômica e sem corrida:
// `UPDATE ... SET usedAt = now() WHERE userId = ? AND codeHash = ? AND usedAt IS NULL`.
// Global (via User): fora de TENANT_SCOPED_MODELS.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Também serve a "listar/contar códigos do usuário" (prefixo userId).
  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

// Item 4 — Auditoria APPEND-ONLY (trigger bloqueia UPDATE; DELETE vale só para o CASCADE da empresa e a
// retenção). Por isso `actorUserId` e `targetId` NÃO têm FK: SetNull seria um UPDATE e o trigger o
// barraria. `tenantId` nulo = ação da plataforma (admin) sem empresa. `actorRole`: OWNER | STAFF |
// PLATFORM_ADMIN | SYSTEM. `action` = código estável tipo "service.price_changed". `summary` = frase
// curta em português (até 300). `changes` = { campo: { de, para } } SEM segredos, até 8 KB (CHECKs).
// `ipTruncated` = IPv4 /24 ou IPv6 /48 (LGPD: dá região, não identifica o aparelho). Fora de
// TENANT_SCOPED_MODELS: o Admin lê todas as empresas; as telas da empresa filtram por tenantId à mão.
model AuditLog {
  id               String   @id @default(cuid())
  tenantId         String?
  actorUserId      String?
  actorRole        String
  action           String
  targetType       String?
  targetId         String?
  summary          String
  changes          Json?
  ipTruncated      String?
  supportSessionId String?
  createdAt        DateTime @default(now())

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportSession SupportSession? @relation(fields: [supportSessionId], references: [id], onDelete: SetNull)

  // Histórico da empresa (paginado, mais recente primeiro) e visão do Admin (todas).
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([supportSessionId])
  @@map("audit_logs")
}

// Item 6 — Cupons. Global (a plataforma cria); não entra em TENANT_SCOPED_MODELS. `code` é gravado
// em MAIÚSCULAS (CHECK code = upper(code)) e @unique => único sem diferenciar caixa; o código
// normaliza a entrada com trim().toUpperCase(). `kind`: PERCENT (value 1-100) | AMOUNT (value em
// centavos > 0, abatido de CADA fatura coberta). `duration`: ONCE (só a 1ª fatura) | N_CYCLES
// (durationCycles >= 1) | FOREVER. `durationCycles` conta FATURAS, não meses. `appliesToCycles`: lista de ciclos válidos (vazia = todos). Planos válidos: linhas em
// CouponPlan; NENHUMA linha = vale para todos os planos. `maxRedemptions` nulo = ilimitado; o CHECK
// (redemptionsCount <= maxRedemptions) garante o teto no banco: resgatar =
// `UPDATE coupons SET redemptionsCount = redemptionsCount + 1 WHERE id = ? AND active AND
// (maxRedemptions IS NULL OR redemptionsCount < maxRedemptions)`. Nunca apagar (FKs RESTRICT).
model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  kind             String
  value            Int
  validFrom        DateTime?
  validUntil       DateTime?
  maxRedemptions   Int?
  redemptionsCount Int       @default(0)
  duration         String    @default("ONCE")
  durationCycles   Int?
  // DEPRECIADA (migration 20261013000000): substituída por `appliesToCycles`. Mantida porque a versão
  // anterior ainda lê; o código novo não deve ler nem gravar. Default ANY mantém inserts novos válidos.
  appliesToCycle   String    @default("ANY")
  // Ciclos em que o cupom vale: subconjunto de MONTHLY|QUARTERLY|SEMIANNUAL|ANNUAL (CHECK). Vazio = todos.
  appliesToCycles  String[]  @default([])
  active           Boolean   @default(true)
  // Sem FK (quem criou).
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  plans         CouponPlan[]
  subscriptions Subscription[]
  redemptions   CouponRedemption[]

  @@map("coupons")
}

model CouponPlan {
  couponId String
  planId   String

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@index([planId])
  @@map("coupon_plans")
}

// Um resgate = a empresa ADOTOU o cupom (as N faturas descontadas depois NÃO geram novo resgate; ficam
// em Invoice.discountCents). Único por (cupom, empresa): a mesma empresa não reaproveita o cupom.
// Fora de TENANT_SCOPED_MODELS (lido pelo Admin e no cadastro, antes de haver sessão).
// `invoiceId` = fatura em que o desconto entrou pela primeira vez (nula até existir).
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  tenantId      String
  invoiceId     String?
  discountCents Int      @default(0)
  createdAt     DateTime @default(now())

  coupon  Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([couponId, tenantId])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("coupon_redemptions")
}

// Item 7 — Lista de espera / encaixe. Tenant-scoped (entra em TENANT_SCOPED_MODELS).
// `desiredDate` = dia local do tenant (DATE, sem hora). `period`: ANY | MORNING | AFTERNOON | EVENING.
// Janela fina opcional: `windowStartMin`/`windowEndMin` (minutos desde 00:00 local; os dois ou nenhum,
// start < end); quando presente, vale no lugar do `period`. `professionalId` nulo = qualquer.
// `status`: WAITING | OFFERED | ACCEPTED | EXPIRED | CANCELED | FULFILLED. OFFERED exige
// offeredSlotStart/offeredAt/offerExpiresAt/offeredProfessionalId (CHECK). `appointmentId` = agendamento
// gerado (único; SetNull se o agendamento sumir). `source`: BOT | PANEL.
// Dois ÚNICOS PARCIAIS (SQL à mão): no máximo 1 entrada ativa (WAITING/OFFERED) por
// contato+serviço+dia+profissional(ou qualquer); e no máximo 1 oferta OFFERED por horário+profissional
// (o mesmo horário não é oferecido a duas pessoas ao mesmo tempo).
// Ordem da fila: createdAt ASC (FIFO), com `id` de desempate.
model WaitlistEntry {
  id                    String    @id @default(cuid())
  tenantId              String
  contactId             String
  serviceId             String
  professionalId        String?
  desiredDate           DateTime  @db.Date
  period                String    @default("ANY")
  windowStartMin        Int?
  windowEndMin          Int?
  status                String    @default("WAITING")
  offeredSlotStart      DateTime? @db.Timestamptz
  offeredProfessionalId String?
  offeredAt             DateTime? @db.Timestamptz
  offerExpiresAt        DateTime? @db.Timestamptz
  appointmentId         String?   @unique
  source                String    @default("BOT")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact             Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service             Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional        Professional? @relation("WaitlistProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
  offeredProfessional Professional? @relation("WaitlistOfferedProfessional", fields: [offeredProfessionalId], references: [id], onDelete: SetNull)
  appointment         Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Achar a fila de um serviço num dia, por status, em ordem de chegada.
  @@index([tenantId, serviceId, desiredDate, status, createdAt])
  // Job de expiração de oferta: status OFFERED vencido.
  @@index([status, offerExpiresAt])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------------
// Suporte — Impersonação de Admin (Onda 1)
// ---------------------------------------------------------------------------

enum SupportSessionCloseReason {
  EXITED
  EXPIRED
  REVOKED
}

model SupportSession {
  id          String                     @id @default(uuid())
  tenantId    String
  adminUserId String
  reason      String                     @db.VarChar(500)
  startedAt   DateTime                   @default(now())
  expiresAt   DateTime
  closedAt    DateTime?
  closeReason SupportSessionCloseReason?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin     User       @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@index([tenantId, closedAt])
  @@index([adminUserId, closedAt])
  @@map("support_sessions")
}

// ---------------------------------------------------------------------------
// Resgate de Leads — Meta Ads / Abandono de Funil (Fase 1)
// ---------------------------------------------------------------------------

enum RescueLeadStatus {
  PENDING
  MESSAGE_1_SENDING
  MESSAGE_1_SENT
  MESSAGE_2_SENDING
  MESSAGE_2_SENT
  RESPONDED
  CONVERTED
  OPTED_OUT
  EXPIRED
  SKIPPED
}

model RescueLead {
  id        String           @id @default(cuid())
  userId    String           @unique
  tenantId  String
  phoneE164 String
  status    RescueLeadStatus @default(PENDING)

  step1ScheduledAt DateTime
  step1SentAt      DateTime?
  step2ScheduledAt DateTime?
  step2SentAt      DateTime?

  nextRunAt     DateTime?
  attempts      Int       @default(0)
  lastErrorCode String?

  optedOutAt  DateTime?
  convertedAt DateTime?
  respondedAt DateTime?

  platformConnectionId String?
  senderPhoneE164      String?
  providerMessageId1   String?
  providerMessageId2   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformConnection PlatformWhatsappConnection? @relation(fields: [platformConnectionId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
  @@index([phoneE164])
  @@index([tenantId])
  @@map("rescue_leads")
}
