// InnoChat — schema Fases 1, 2, 4 e 7 (docs/arquitetura.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Fase 1 — Identidade e plataforma
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // null = conta criada só pelo Google (sem senha). Login por senha responde "esta conta usa
  // Google"; "esqueci a senha" permite DEFINIR uma. Nunca gravar string vazia.
  passwordHash      String?
  // `sub` do Google (id estável da conta Google). Vincula o usuário ao login com Google; @unique
  // impede duas contas InnoChat no mesmo Google.
  googleSub         String?   @unique
  // Versão da sessão: o JWT carrega `sv`; se o banco tiver outro valor a sessão deixa de valer.
  // Incrementa quando algo deve derrubar sessões abertas (vínculo Google em conta não verificada,
  // redefinição de senha, "sair de todos os dispositivos").
  sessionVersion    Int       @default(0)
  emailVerifiedAt  DateTime?
  isPlatformAdmin   Boolean   @default(false)
  termsAcceptedAt   DateTime?
  termsVersion      String?
  // Onboarding (tour guiado do Inno): por USUÁRIO — funcionário novo também vê o tour.
  // null = ainda não concluiu/pulou.
  onboardingTourCompletedAt DateTime?
  // Nome de exibição (até 80 caracteres — limite na validação, não no banco). null = sem nome.
  name              String?
  // Notificações da plataforma (admin): "marcar todas como lidas" = tudo com data <= este instante.
  platformNotificationsReadAllAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  platformNotificationReads PlatformNotificationRead[]
  memberships       Membership[]
  authTokens        AuthToken[]
  chatMessagesAuthored ChatMessage[] @relation("ChatMessageAuthor")
  platformSettingsUpdates PlatformSettings[] @relation("PlatformSettingsUpdatedBy")

  @@map("users")
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  INVITE
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

// Instalação única do primeiro admin da plataforma (`/instalacao`, docs/contratos.md). Sem
// `userId`: nasce antes de existir qualquer `User` administrador. Regenerado a cada boot do
// servidor enquanto não houver admin (`src/instrumentation.ts`) — por isso não precisa de mais
// de uma linha vigente; a camada de aplicação apaga a anterior antes de criar a nova.
model PlatformInstallCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("platform_install_codes")
}

enum PanelTheme {
  INDIGO_CLINICO
  AMBAR_ESTUDIO
  VERDE_SLATE
}

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  timezone  String
  // CPF/CNPJ da empresa (só dígitos), exigido pelo Mercado Pago para criar cobrança Pix
  // (`payer.identification` — ver `src/modules/billing/mercadopago.ts`). Decisão do dono,
  // 2026-09-29: como a PRIMEIRA fatura (com Pix) já nasce no cadastro, `signUpAction` passou a
  // EXIGIR este campo (`INVALID_DOCUMENT` se o dígito verificador for inválido) — toda empresa
  // criada a partir de então já nasce com `document` preenchido. Continua `String?` (nullable)
  // só por causa das empresas criadas ANTES desta mudança (nasceram com `null`) — para elas,
  // `updateTenantDocumentAction` (`src/modules/tenant/actions.ts`) continua existindo para
  // corrigir depois. Enquanto for `null`, a fatura nasce sem Pix (mesmo caminho já existente de
  // "Mercado Pago indisponível").
  document  String?
  segment   String?
  // Tema visual do painel (decisão do dono, 2026-09-28): só os 3 temas prontos abaixo — sem cor
  // personalizada, sem modo escuro e sem logo.
  theme     PanelTheme @default(INDIGO_CLINICO)

  // Regras de agenda/bot em colunas escalares (§5).
  // Grade de horários ancorada (bot v2): 15 ou 30 (CHECK no banco). Padrão 30 desde o bot v2.
  slotGranularityMin        Int     @default(30)
  minLeadTimeMin            Int     @default(60)
  maxHorizonDays            Int     @default(30)
  cancelMinLeadMin          Int     @default(120)
  sessionTimeoutMin         Int     @default(30)
  humanPauseMin             Int     @default(720)
  askProfessional           Boolean @default(true)
  maxWhatsappNumbersOverride Int?
  maxProfessionalsOverride   Int?
  // Onboarding: o checklist "Primeiros passos" é por EMPRESA; null = visível.
  onboardingChecklistDismissedAt DateTime?
  // Lembrete de véspera ao cliente por WhatsApp.
  reminderEnabled     Boolean @default(true)
  reminderHoursBefore Int     @default(24)
  // Bot v2. 0 = sem limite de agendamentos futuros por contato no WhatsApp (CHECK 0..20).
  maxFutureAppointmentsPerContact Int @default(3)
  // Atendimento humano: avisa o cliente no WhatsApp quando a EQUIPE agenda/remarca/cancela pelo painel.
  notifyClientOnStaffChanges Boolean @default(true)
  // Minutos até o bot retomar após atendimento humano (CHECK 30..1440).
  handoffResumeMinutes            Int @default(120)

  // Contato de cobrança (régua, docs/regua-de-cobranca.md D4/D5). `billingEmail` nulo = os avisos vão
  // para o OWNER mais antigo (comportamento de sempre); preenchido = recebe tudo e o dono continua
  // recebendo as etapas críticas. `billingWhatsappE164` = só dígitos com DDI (CHECK 12..13); nulo = sem
  // WhatsApp de cobrança. Decisão D5 do dono (2026-10-01): WhatsApp ATIVO PARA TODOS, sem opt-in;
  // `billingWhatsappOptOutAt` preenchido = a empresa desligou (pela tela Assinatura ou respondendo SAIR)
  // e é a prova do pedido. Nulo = recebe. Nenhum número é inventado: sem `billingWhatsappE164` a etapa
  // de WhatsApp é pulada (NO_RECIPIENT).
  billingEmail            String?
  billingWhatsappE164     String?
  billingWhatsappOptOutAt DateTime?
  // Posse do número de cobrança confirmada: o assinante respondeu SIM ao número da plataforma. Nulo =
  // não confirmado (qualquer um pode digitar o número de outra pessoa no cadastro): o WhatsApp sai no
  // máximo 1 vez por dia e com o convite para responder SIM ou SAIR. Volta a nulo quando o número muda.
  billingWhatsappConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  services           Service[]
  professionals       Professional[]
  scheduleExceptions ScheduleException[]
  contacts           Contact[]
  appointments       Appointment[]
  whatsappInstances  WhatsappInstance[]
  botTexts           BotText[]
  subscription       Subscription?
  trialClaims        TrialClaim[]
  chatMessages       ChatMessage[]
  handoffRequests    HandoffRequest[]
  billingNotices     BillingNotice[]
  billingEvents      BillingEvent[]

  @@map("tenants")
}

enum MembershipRole {
  OWNER
  STAFF
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole
  createdAt DateTime       @default(now())
  // Central de notificações: "marcar todas como lidas" = tudo com createdAt <= este instante.
  // Leitura individual fica em NotificationRead. Por (usuário, empresa) porque a Membership já é isso.
  notificationsReadAllAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notificationReads NotificationRead[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

// Leitura INDIVIDUAL de uma notificação (as notificações em si são derivadas, não materializadas —
// ver src/modules/notifications/service.ts). `notificationKey` = id estável da notificação
// (ev:<eventId>, upcoming:<appointmentId>, wa:..., trial:..., pay:...). Sem tenantId próprio: o
// isolamento é pela Membership (que é por usuário+empresa).
model NotificationRead {
  id              String   @id @default(cuid())
  membershipId    String
  notificationKey String
  readAt          DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, notificationKey])
  @@index([readAt])
  @@map("notification_reads")
}

enum MercadoPagoEnvironment {
  PRODUCTION
  SANDBOX
}

// Singleton: sempre id = 1. A camada de aplicação faz upsert(where: { id: 1 }); nunca cria uma
// segunda linha. Não há constraint de banco reforçando "só 1 linha" — decisão consciente para não
// complicar a migração; se isso doer, trocar por CHECK (id = 1) é barato depois.
model PlatformSettings {
  id Int @id @default(1)

  // URL pública do painel (decisão do dono, 2026-09-28: nada de URL/credencial solta em env
  // var — só `DATABASE_URL`/`AUTH_SECRET` sobram no Easypanel). Normalmente derivada da própria
  // requisição (`src/lib/public-url.ts`, cabeçalhos `x-forwarded-host`/`x-forwarded-proto`);
  // este campo é só o OVERRIDE para contextos sem requisição (tick/cron) — preenchido sozinho
  // na 1ª vez que um admin salva Configurações, nunca editado à mão na v1.
  publicBaseUrl String?

  // Login com Google (OAuth). Client ID/Secret cadastrados em Admin > Configurações — nada em env
  // var. O secret é cifrado (`enc:v1:`, src/lib/crypto.ts). O provedor só entra no Auth.js quando
  // `googleAuthEnabled` está ligado com ID e secret que decifram.
  googleAuthEnabled   Boolean @default(false)
  googleClientId      String?
  googleClientSecretEnc String?

  evolutionApiUrl String?
  evolutionApiKey String?

  n8nWebhookBaseUrl     String?
  internalApiSecretHash String?

  // Sincronização do n8n pelo painel (Fase 7+, docs/contratos.md "Configuração pela
  // plataforma"): API pública do n8n (`n8nBaseUrl` = ex. `https://n8n.exemplo.com`,
  // `n8nApiKey` mascarada na UI) e os IDs encontrados/criados na última sincronização — para a
  // sync ser idempotente (atualiza a mesma credencial/workflow, nunca duplica).
  n8nBaseUrl String?
  n8nApiKey  String?

  n8nCredPainelId    String?
  n8nCredEvolutionId String?
  n8nCredApiId       String?
  n8nWorkflowBotId    String?
  n8nWorkflowErrosId  String?
  // `innochat-cron` (Schedule de hora em hora → POST /billing/tick, ver src/modules/platform/
  // n8n-sync.ts) — opcional: pode não existir ainda no n8n do dono, `syncN8n` não falha por
  // isso, só avisa no resumo.
  n8nWorkflowCronId   String?

  // Publicação do fluxo do bot pelo painel (bot v2, docs/bot-v2-plano.md §3.1/§3.6).
  n8nBotFlowVersion           String?   // Config.flowVersion do JSON publicado, ex.: "2.0.0"
  n8nBotFlowHash              String?   // hash canônico do que foi publicado
  n8nBotFlowPublishedAt       DateTime?
  n8nBotFlowPublishedByUserId String?   // sem FK (auditoria simples)
  n8nBotFlowPrevious          Json?     // { version, hash, nodes, connections } do vivo antes do último PUT

  // LEGADO (pré-2026-09-29): texto puro. Migração preguiçosa no código (`src/modules/platform/
  // mercadopago-config.ts`, `migrateLegacyPlatformSecrets`): na 1ª leitura/gravação o valor vai,
  // CIFRADO, para o par de PRODUÇÃO abaixo e estas duas colunas são zeradas. Não remover a
  // coluna ainda (migration destrutiva só depois de confirmado em produção).
  mercadoPagoAccessToken   String?
  mercadoPagoWebhookSecret String?

  // Mercado Pago no modelo do Parque das Feiras: par de PRODUÇÃO e par de TESTE (sandbox),
  // `mpEnvironment` escolhe o par ATIVO. Public Key não é segredo (claro); Access Token e
  // Webhook Secret são cifrados (`enc:v1:`, AES-256-GCM com chave derivada do AUTH_SECRET —
  // `src/lib/crypto.ts`). `mpEnabled=false` bloqueia só COBRANÇA NOVA (webhook segue valendo).
  mpEnvironment          MercadoPagoEnvironment @default(PRODUCTION)
  mpEnabled              Boolean                @default(true)
  mpProdPublicKey        String?
  mpProdAccessTokenEnc   String?
  mpProdWebhookSecretEnc String?
  mpTestPublicKey        String?
  mpTestAccessTokenEnc   String?
  mpTestWebhookSecretEnc String?

  // E-mail transacional via SMTP próprio (decisão do dono, 2026-09-28). emailProvider/emailApiKey
  // do desenho original da Nova (§1, §5) ficam de fora — não cabem no SMTP puro; se um provedor
  // de e-mail transacional (Resend etc.) entrar depois, é campo novo, não retrofit destes.
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?

  // ÓRFÃO (decisão do dono, 2026-09-29): nenhum código lê/grava isto — o cadastro público confere
  // `TERMS_VERSION` (src/lib/legal.ts) direto, e nunca existiu tela de admin editando este campo.
  // Coluna mantida de propósito (nenhuma migration destrutiva sem necessidade real) — candidata
  // a uma migration de remoção quando convier ao Cronos.
  termsVersion String?

  // Dados jurídicos da empresa OPERADORA do InnoChat (Innovare Code) — decisão do dono,
  // 2026-09-29: nada disso pelo chat/código, tudo cadastrável pelo admin (tela "Dados
  // jurídicos"). Todos opcionais e NENHUM é segredo (podem voltar em claro pela action de
  // leitura) — são os mesmos dados que já apareceriam public/mente nos Termos/Privacidade.
  // `getPublicLegalInfo()` (src/modules/platform/legal-service.ts) expõe só estes campos para
  // as páginas `/termos` e `/privacidade` substituírem os marcadores `[CNPJ]`, `[ENDEREÇO]` etc.
  companyLegalName     String?
  companyCnpj          String?
  companyAddress       String?
  contactEmail         String?
  dpoName              String?
  dpoEmail             String?
  forumCity            String?
  hostingRegion        String?
  backupRetentionDays  Int?

  // WhatsApp comercial da empresa (botão "Tirar dúvidas" da landing). E.164 só dígitos com DDI
  // (`558431132584`); nulo = botão some. Não é segredo. Lido por `getPublicSalesWhatsapp()`
  // (src/modules/platform/sales-contact.ts); cadastrado em Admin → Configurações.
  salesWhatsappE164    String?

  // Chave geral da régua por WhatsApp (docs/regua-de-cobranca.md §2.4). Desligada = a régua roda só por
  // e-mail e sino. O número em si mora em `PlatformWhatsappConnection` (conexão ACTIVE), nunca aqui.
  platformWhatsappEnabled Boolean @default(false)

  // Última execução dos jobs periódicos (`billing/tick`/`maintenance/tick`, chamados por cron
  // externo) — para a tela admin "Saúde" mostrar quando rodou e o resultado, e alertar se um tick
  // parou de rodar (docs/contratos.md, seção "Admin Saúde"). `*Result` guarda o resumo já
  // devolvido por cada tick (`BillingTickSummary`/`MaintenanceTickSummary`), sem achatar em
  // colunas novas a cada contador futuro.
  lastBillingTickAt        DateTime?
  lastBillingTickResult     Json?
  lastMaintenanceTickAt     DateTime?
  lastMaintenanceTickResult Json?

  // Diagnóstico do webhook do Mercado Pago (Admin → Saúde): último recebido (qualquer desfecho) e
  // última rejeição com o motivo. JSON pequeno `{ outcome|reason, environment, type }` — NUNCA o
  // corpo da notificação nem segredo/assinatura.
  lastMpWebhookAt         DateTime?
  lastMpWebhookResult     Json?
  lastMpWebhookRejectedAt DateTime?
  lastMpWebhookRejection  Json?

  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Fase 2 — Catálogo e agenda
// ---------------------------------------------------------------------------

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  durationMin    Int
  bufferAfterMin Int      @default(0)
  priceCents     Int?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionalServices  ProfessionalService[]
  appointments          Appointment[]

  @@index([tenantId, active, sortOrder])
  @@map("services")
}

model Professional {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingHours         WorkingHour[]
  professionalServices ProfessionalService[]
  scheduleExceptions   ScheduleException[]
  appointments         Appointment[]

  @@index([tenantId, active, sortOrder])
  @@map("professionals")
}

model ProfessionalService {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

// Hora local ("HH:mm") — o cálculo de slots converte para o fuso do Tenant (core/agenda).
model WorkingHour {
  id             String   @id @default(cuid())
  professionalId String
  weekday        Int // 0 (domingo) .. 6 (sábado)
  startTime      String // "HH:mm"
  endTime        String // "HH:mm"
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("working_hours")
}

enum ScheduleExceptionType {
  BLOCK
  HOLIDAY
}

// professionalId nulo = escopo da empresa inteira.
model ScheduleException {
  id             String                 @id @default(cuid())
  tenantId       String
  professionalId String?
  type           ScheduleExceptionType
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime               @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@map("schedule_exceptions")
}

model Contact {
  id            String    @id @default(cuid())
  tenantId      String
  waJid         String
  phoneE164     String?
  lid           String?
  name          String?
  pushName      String?
  notes         String?
  botPausedUntil DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]
  handoffRequests HandoffRequest[]

  @@unique([tenantId, waJid])
  @@index([tenantId])
  @@map("contacts")
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  WHATSAPP
  PANEL
}

model Appointment {
  id                String            @id @default(cuid())
  tenantId          String
  contactId         String
  serviceId         String
  professionalId    String
  whatsappInstanceId String?
  // timestamptz explícito: o EXCLUDE usa tstzrange(startsAt, blockEndsAt) e essa função só é
  // IMMUTABLE (exigido em índice) sobre timestamptz — timestamp "naive" force um cast implícito
  // dependente do TimeZone da sessão, e a criação da constraint falha.
  startsAt          DateTime @db.Timestamptz
  endsAt            DateTime @db.Timestamptz
  // endsAt + Service.bufferAfterMin no momento da reserva — denormalizado de propósito: é o campo
  // usado no range do EXCLUDE (migration SQL manual, ver 0002_appointment_exclude_no_overlap).
  blockEndsAt       DateTime @db.Timestamptz
  status            AppointmentStatus @default(SCHEDULED)
  source            AppointmentSource @default(WHATSAPP)
  idempotencyKey    String?
  // Lembrete de véspera já enviado (null = pendente). Zerar ao remarcar.
  reminderSentAt    DateTime? @db.Timestamptz
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional     Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  events           AppointmentEvent[]

  // Índices para as consultas quentes (§5, §8):
  // - disponibilidade por profissional e dia
  // - agendamentos por tenant e período
  @@index([professionalId, startsAt])
  @@index([tenantId, startsAt])
  // Job de lembrete: status = SCHEDULED AND reminderSentAt IS NULL AND startsAt entre X e Y.
  @@index([status, reminderSentAt, startsAt])
  @@unique([tenantId, idempotencyKey])
  @@map("appointments")
}
// A constraint EXCLUDE USING gist (professionalId, tstzrange(startsAt, blockEndsAt, '[)')) WHERE
// status = 'SCHEDULED' está na migration SQL manual 0002_appointment_exclude_no_overlap (precisa
// de btree_gist; Prisma não expressa EXCLUDE no schema).

enum AppointmentEventAuthorType {
  CONTACT
  USER
  SYSTEM
}

enum AppointmentEventAction {
  CREATED
  CANCELED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  // Desfez COMPLETED/NO_SHOW (voltou para SCHEDULED). Não gera notificação.
  REOPENED
}

// Trilha imutável: só INSERT pela aplicação.
model AppointmentEvent {
  id            String                     @id @default(cuid())
  appointmentId String
  action        AppointmentEventAction
  authorType    AppointmentEventAuthorType
  authorId      String?
  note          String?
  createdAt     DateTime                   @default(now())
  // Denormalizado para a central de notificações (consulta por empresa + período sem join).
  // Preenchido por TRIGGER no banco (migration 20260930100000) a partir de appointments — nunca
  // depende do código de aplicação lembrar de gravar. Nulo só transitoriamente.
  tenantId      String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@index([tenantId, createdAt])
  @@map("appointment_events")
}

// ---------------------------------------------------------------------------
// Fase 4 — Bot (instâncias, sessão de conversa, dedupe, textos)
// ---------------------------------------------------------------------------

enum WhatsappInstanceStatus {
  QRCODE
  CONNECTED
  DISCONNECTED
}

model WhatsappInstance {
  id              String                  @id @default(cuid())
  tenantId        String
  instanceName    String                  @unique
  label           String
  status          WhatsappInstanceStatus  @default(QRCODE)
  phoneE164       String?
  webhookToken    String                  @unique
  // true = instância de teste (nó 11 do workflow desvia o envio para /sandbox/outbox em vez da
  // Evolution real). Usada pela bateria de roteiros (§8) e para validar edições do dono no n8n.
  sandbox         Boolean                 @default(false)
  lastConnectedAt DateTime?
  // Queda INESPERADA (CONNECTED → DISCONNECTED por evento/polling). Zera ao reconectar e ao
  // desconectar manualmente. Alimenta a notificação WHATSAPP_DISCONNECTED.
  disconnectedAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]
  inboundEvents InboundEvent[]
  appointments Appointment[]
  chatMessages ChatMessage[]
  handoffRequests HandoffRequest[]

  @@index([tenantId])
  @@map("whatsapp_instances")
}

model ChatSession {
  id                 String   @id @default(cuid())
  whatsappInstanceId String
  contactId          String
  // Estado da máquina do menu (§3) — de propriedade do n8n, não validado por enum no banco:
  // o Switch do workflow decide os valores válidos, e travar isso aqui obrigaria uma migration
  // toda vez que o dono adicionar um passo no fluxo do n8n.
  state              String
  context            Json     @default("{}")
  invalidCount       Int      @default(0)
  version            Int      @default(0)
  lockToken          String?
  lockedUntil        DateTime?
  lastInboundAt      DateTime @default(now())
  humanUntil         DateTime?
  // Hashes + instante das últimas saídas (janela de ~2 min) para reconhecer o eco `fromMe` (§2.7).
  recentOutbound     Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  handoffRequests  HandoffRequest[]

  // Chave de acesso do endpoint /messages/claim: WHERE whatsappInstanceId = ? AND contactId = ?.
  @@unique([whatsappInstanceId, contactId])
  @@map("chat_sessions")
}

enum HandoffReason {
  CLIENT_REQUEST
  LEGACY_FLOW
}

enum HandoffEndReason {
  CLIENT_MENU
  TIMEOUT
  PANEL_RESUME
}

// Pedido de atendimento humano (bot v2). No máximo UM aberto (endedAt IS NULL) por sessão: índice
// único parcial "handoff_requests_one_open_per_session" na migration SQL (o Prisma não expressa
// índice parcial; o diff não o reclama).
model HandoffRequest {
  id                 String            @id @default(cuid())
  tenantId           String
  whatsappInstanceId String
  contactId          String
  chatSessionId      String
  reason             HandoffReason
  offHours           Boolean           @default(false)
  requestedAt        DateTime          @default(now())
  // 1ª resposta fromMe da equipe.
  answeredAt         DateTime?
  endedAt            DateTime?
  endReason          HandoffEndReason?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  chatSession      ChatSession      @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestedAt])
  @@index([chatSessionId, endedAt])
  @@map("handoff_requests")
}

enum InboundOutcome {
  PROCESS
  BUSY
  IGNORE
}

enum InboundIgnoreReason {
  DUPLICATE
  STALE
  GROUP
  UNSUPPORTED_EVENT
  FROM_ME_ECHO
  HUMAN_TOOK_OVER
  HUMAN_MODE
  BOT_PAUSED
  TENANT_SUSPENDED
  UNRESOLVABLE_SENDER
  // Remetente é número que já foi do WhatsApp da plataforma (cobrança): o bot da empresa nunca responde (anti-loop).
  PLATFORM_SENDER
}

// Dedupe + trilha de auditoria do webhook. Sem conteúdo de mensagem (LGPD, §11) — purga após 30
// dias (job fora do escopo deste schema; ver PENDÊNCIAS no handoff).
model InboundEvent {
  id                 String              @id @default(cuid())
  whatsappInstanceId String
  providerMessageId  String
  outcome            InboundOutcome
  reason             InboundIgnoreReason?
  stateBefore        String?
  stateAfter         String?
  createdAt          DateTime            @default(now())

  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@unique([whatsappInstanceId, providerMessageId])
  @@index([createdAt])
  @@map("inbound_events")
}

// Enum fechado (§6.7); os padrões de cada chave ficam no código do painel — só existe linha aqui
// quando o tenant edita o texto.
