enum InboundIgnoreReason {
  DUPLICATE
  STALE
  GROUP
  UNSUPPORTED_EVENT
  FROM_ME_ECHO
  HUMAN_TOOK_OVER
  HUMAN_MODE
  BOT_PAUSED
  TENANT_SUSPENDED
  UNRESOLVABLE_SENDER
  // Remetente é número que já foi do WhatsApp da plataforma (cobrança): o bot da empresa nunca responde (anti-loop).
  PLATFORM_SENDER
